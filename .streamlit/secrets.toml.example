# Copy this file to `.streamlit/secrets.toml` for local dev, or paste these
# keys into the "Secrets" box of your Streamlit Community Cloud app.
# secrets.toml itself is gitignored — never commit your real key.

# Required only for the AI Assistant (chat) tab. Get a free key at
# https://console.groq.com . The Guided Wizard works without it.
GROQ_API_KEY = "your-groq-api-key-here"

# Optional: use a different LiteLLM-supported model instead of the Groq default.
# WATTWISE_MODEL = "gemini/gemini-2.5-flash"
